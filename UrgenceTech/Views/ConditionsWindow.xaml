<Window x:Class="UrgenceTech.Views.ConditionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Conditions d'utilisation"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0"
                   Text="Conditions d'utilisation"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      BorderBrush="#FFCCCCCC"
                      BorderThickness="1"
                      Padding="10">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,6" Text="1. Acceptation des conditions"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13">
                    En créant un compte sur UrgenceTech, vous acceptez sans réserve les présentes conditions d'utilisation. Si vous n'acceptez pas ces conditions, veuillez ne pas créer de compte.
                </TextBlock>

                <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,6" Text="2. Utilisation du service"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13">
                    UrgenceTech est une plateforme destinée à la gestion des urgences médicales. Vous vous engagez à utiliser ce service uniquement à des fins légitimes et conformes aux lois en vigueur.
                </TextBlock>

                <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,6" Text="3. Confidentialité des données"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13">
                    Vos informations personnelles (nom, courriel) sont collectées uniquement dans le but de vous fournir le service. Elles ne seront jamais partagées avec des tiers sans votre consentement explicite.
                </TextBlock>

                <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,6" Text="4. Sécurité du compte"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13">
                    Vous êtes responsable de la confidentialité de votre mot de passe. Après plusieurs tentatives de connexion échouées, votre compte peut être temporairement verrouillé pour votre protection.
                </TextBlock>

                <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,6" Text="5. Modifications des conditions"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13">
                    UrgenceTech se réserve le droit de modifier ces conditions à tout moment. Les utilisateurs seront informés de tout changement important par courriel ou lors de leur prochaine connexion.
                </TextBlock>

                <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,6" Text="6. Contact"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13">
                    Pour toute question relative aux présentes conditions, veuillez contacter notre équipe de support à support@urgencetech.ca.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Fermer"
                Width="120" Height="36"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Background="#FF5070DE"
                Foreground="White"
                Click="FermerBTN_Click"/>
    </Grid>
</Window>
