<Page x:Class="UrgenceTech.Views.SignIn"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:UrgenceTech.Views"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SignIn"
      Background="Transparent">

    <Grid>
        <!-- Formulaire de connexion -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Background="White" BorderBrush="Black" BorderThickness="3" Width="500" Height="400" RenderTransformOrigin="0.541,1.614">
                <StackPanel>
                    <Label Content="Connexion" Width="127" FontSize="20" RenderTransformOrigin="0.444,0.185" Height="38" Margin="30" FontWeight="Bold"/>
                    <Label Content="Courriel" Width="62" FontSize="12" RenderTransformOrigin="0.444,0.185" Height="38" HorizontalAlignment="Left" Margin="140,0,0,-15"/>
                    <TextBox x:Name="Email" Width="200" Height="22" BorderBrush="Black" Margin="15" Tag="Email"/>
                    <Label Content="Mot de passe" Width="90" FontSize="12" RenderTransformOrigin="0.444,0.185" Height="38" HorizontalAlignment="Left" Margin="140,0,0,-15"/>
                    <PasswordBox x:Name="MotPasse" Width="200" Height="22" BorderBrush="Black" Margin="15" Tag="Mot de passe"/>
                    <StackPanel Orientation="Horizontal" Width="264">
                        <Button x:Name="SignInBtn" Content="Connecter" Width="96" Height="40" Background="#FF5070DE" Foreground="White" Click="SignInBtn_Click" Margin="15" FontWeight="Bold"/>
                        <Button x:Name="GoToSignUpBtn" Content="Créer un compte" Width="117" Height="40" Background="#FF5070DE" Foreground="White" Click="GoToSignUpBtn_Click" FontWeight="Bold"/>
                    </StackPanel>
                    <!-- Boîte d'erreur avec icône -->
                    <Border x:Name="ErreurBorder"
                            Background="#FFEBEE"
                            BorderBrush="#F44336"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="15,5,15,5"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="MessageErreur"
                                       Foreground="#F44336"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Overlay de chargement — couvre toute la page et bloque les clics -->
        <Grid x:Name="ChargementOverlay"
              Visibility="Collapsed"
              Background="#88000000">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="White"
                        Width="200"
                        Height="100">
                <!-- Spinner animé -->
                <ProgressBar x:Name="Spinner"
                             IsIndeterminate="True"
                             Width="140"
                             Height="12"
                             Margin="0,18,0,10"/>
                <!-- Texte affiché sous le spinner -->
                <TextBlock Text="Connexion en cours…"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="#FF5070DE"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
