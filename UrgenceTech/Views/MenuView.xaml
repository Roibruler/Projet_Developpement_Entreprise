<Window x:Class="UrgenceTech.Views.MenuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UrgenceTech.Views"
        Title="UrgenceTech - Menu Principal"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid MouseMove="OnUserActivity" KeyDown="OnUserActivity">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1976D2">
            <StackPanel Margin="0,20,0,0">

                <TextBlock Text="🏥 UrgenceTech"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <Button Content="📊  Tableau de bord"
                        Style="{StaticResource NavBouton}"
                        Click="NavTableauDeBord_Click"/>

                <Button Content="🚨  Urgences"
                        Style="{StaticResource NavBouton}"
                        Click="NavUrgences_Click"/>

                <Button Content="👥  Utilisateurs"
                        Style="{StaticResource NavBouton}"
                        Click="NavUtilisateurs_Click"/>

                <Button Content="🚪  Déconnexion"
                        Style="{StaticResource NavBoutonDeconnexion}"
                        Click="Deconnexion_Click"/>

            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" x:Name="ContenuPrincipal"/>

    </Grid>
</Window>