<Page x:Class="UrgenceTech.Views.AccueilAdmin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UrgenceTech.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TestAdmin"
      Background="White">



    <Grid MouseMove="OnUserActivity" KeyDown="OnUserActivity" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3" Grid.Column="1" Width="200" Height="40" Background="White">
            <TextBlock Text="Admin Place" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <Button Content="Déconnexion" Width="100" Height="20" Click="OnLogout"
             Grid.Column="5" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"/>

        <Button x:Name="ConsulterUser" Grid.ColumnSpan="3" Grid.Column="1" Grid.Row="1" Width="200" Height="40" Content="Consulter la liste des utilisateurs"
            Click="GotoVoirUtilisateur_Click" Margin="140,25,140,25"/>
    </Grid>

</Page>
