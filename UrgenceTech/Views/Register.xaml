<Window x:Class="UrgenceTech.Views.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UrgenceTech — Créer un compte"
        Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F7FA">
        <StackPanel VerticalAlignment="Center" Margin="40,30">

            <!-- Titre -->
            <TextBlock Text="Créer un compte"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#1A3C5E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <!-- Prénom -->
            <TextBlock Text="Prénom" FontSize="13" Foreground="#444" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtPrenom"
                     Height="36" FontSize="13"
                     Padding="8,6" Margin="0,0,0,12"
                     BorderBrush="#BFCBDA" BorderThickness="1"/>

            <!-- Nom -->
            <TextBlock Text="Nom" FontSize="13" Foreground="#444" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtNom"
                     Height="36" FontSize="13"
                     Padding="8,6" Margin="0,0,0,12"
                     BorderBrush="#BFCBDA" BorderThickness="1"/>

            <!-- Courriel -->
            <TextBlock Text="Courriel" FontSize="13" Foreground="#444" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtCourriel"
                     Height="36" FontSize="13"
                     Padding="8,6" Margin="0,0,0,12"
                     BorderBrush="#BFCBDA" BorderThickness="1"/>

            <!-- Mot de passe -->
            <TextBlock Text="Mot de passe" FontSize="13" Foreground="#444" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtMotDePasse"
                         Height="36" FontSize="13"
                         Padding="8,6" Margin="0,0,0,12"
                         BorderBrush="#BFCBDA" BorderThickness="1"/>

            <!-- Confirmation mot de passe -->
            <TextBlock Text="Confirmer le mot de passe" FontSize="13" Foreground="#444" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtConfirmation"
                         Height="36" FontSize="13"
                         Padding="8,6" Margin="0,0,0,16"
                         BorderBrush="#BFCBDA" BorderThickness="1"/>

            <!-- Message d'erreur -->
            <TextBlock x:Name="TxtErreur"
                       Foreground="#C0392B"
                       FontSize="12"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"
                       Visibility="Collapsed"/>

            <!-- Bouton S'inscrire -->
            <Button x:Name="BtnInscrire"
                    Content="S'inscrire"
                    Height="40" FontSize="14"
                    Background="#1A3C5E" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnInscrire_Click"
                    Margin="0,0,0,12"/>

            <!-- Lien vers connexion -->
            <TextBlock HorizontalAlignment="Center" FontSize="12">
                <Run Text="Déjà un compte ? "/>
                <Hyperlink x:Name="LienConnexion" Click="LienConnexion_Click">
                    Se connecter
                </Hyperlink>
            </TextBlock>

        </StackPanel>
    </Grid>
</Window>
