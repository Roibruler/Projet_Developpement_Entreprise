<Page x:Class="UrgenceTech.Views.SignUp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SignUp"
      Background="Transparent">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" BorderBrush="Black" BorderThickness="3" Width="500" Height="450">
            <StackPanel>

                <Label Content="Créer un compte" FontSize="20" Margin="30" FontWeight="Bold"/>
                
                <Border Height="1"
                        Background="#FF5070DE"
                        Margin="20,-30,20,15"/>

                <Label Content="Courriel" Margin="140,0,0,-15"/>
                <TextBox x:Name="Email" Width="200" Margin="15"/>

                <Label Content="Mot de passe" Margin="140,0,0,-15"/>
                <PasswordBox x:Name="MotPasse" Width="200" Margin="15"/>

                <Button Content="Créer le compte"
                        Width="200"
                        Height="40"
                        Margin="15"
                        Background="#FF5070DE"
                        Foreground="White"
                        Click="CreateAccount_Click"/>

                <TextBlock x:Name="MessageErreur"
                           Foreground="Red"
                           TextWrapping="Wrap"
                           Margin="10"/>

                <TextBlock Margin="10">
                    Déjà un compte ?
                    <Hyperlink Click="GoToSignUp_Click">Se connecter</Hyperlink>
                </TextBlock>

                <TextBlock Margin="10">
                    <Hyperlink Click="ForgotPassword_Click">
                        Mot de passe oublié ?
                    </Hyperlink>
                </TextBlock>

            </StackPanel>
        </Border>
    </StackPanel>
</Page>