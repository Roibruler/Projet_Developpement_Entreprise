<Page x:Class="UrgenceTech.Views.SignUp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="UrgenceTech - Créer un compte"
      Background="#F5F5F5">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Width="400">

            <Image Source="/logoUrgenceTech.png" Stretch="Uniform" Height="120" Margin="0,0,0,10"/>

            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="30">
                <StackPanel>

                    <TextBlock Text="Créer un compte" FontSize="22" FontWeight="Bold"
                               Foreground="#1976D2" Margin="0,0,0,20"/>

                    <TextBlock Text="Nom complet" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="NomComplet" Height="35" FontSize="14" Padding="8" Margin="0,0,0,15"/>

                    <TextBlock Text="Courriel" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="Email" Height="35" FontSize="14" Padding="8" Margin="0,0,0,15"/>

                    <TextBlock Text="Mot de passe" FontWeight="Bold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="MotPasse" Height="35" FontSize="14" Padding="8" Margin="0,0,0,15"/>

                    <TextBlock Text="Confirmer le mot de passe" FontWeight="Bold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="ConfirmerMotPasse" Height="35" FontSize="14" Padding="8" Margin="0,0,0,15"/>

                    <TextBlock x:Name="MessageErreurCreationCompte"
                               Foreground="#F44336" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Button x:Name="CreerCompteBTN"
                            Content="Créer un compte"
                            Height="40" FontSize="14" FontWeight="Bold"
                            Background="#1976D2" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="CreerCompteBTN_Click"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Page>