<Page x:Class="UrgenceTech.Views.SignUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrgenceTech.Views"
        mc:Ignorable="d"
        Title="SignUp"
        Background="#FF4F6FDE">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="2066" Height="949">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="767,0,0,0">
            <Image Source="/logoUrgenceTech.png" Stretch="Fill" Width="500" Height="250"/>
            <Border Background="White" BorderBrush="Black" BorderThickness="3" Width="500" Height="660">
                <StackPanel>
                    <Label Content="&#xA;&#xA;Créer un compte" Width="158" FontSize="20" RenderTransformOrigin="0.444,0.185" Height="100" Margin="30"/>
                    <TextBox x:Name="Email" Width="200" Height="40" BorderBrush="Black" Text="Email" Margin="15" GotFocus="RetirerTexte" LostFocus="AjouterTexte" Tag="Email"/>
                    <TextBox x:Name="MotPasse" Width="200" Height="40" BorderBrush="Black" Text="Mot de passe" Margin="15" GotFocus="RetirerTexte" LostFocus="AjouterTexte" Tag="Mot de passe"/>
                    <TextBox x:Name="ConfirmerMotPasse" Width="200" Height="40" BorderBrush="Black" Text="Confirmer mot de passe" Margin="15" GotFocus="RetirerTexte" LostFocus="AjouterTexte" Tag="Confirmer mot de passe"/>
                    <TextBox x:Name="NomComplet" Width="200" Height="40" BorderBrush="Black" Text="Nom Complet" Margin="15" GotFocus="RetirerTexte" LostFocus="AjouterTexte" Tag="Nom Complet"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="15,5,15,0">
                        <CheckBox x:Name="AccepterConditions"
                                  VerticalAlignment="Center"
                                  Checked="AccepterConditions_Changed"
                                  Unchecked="AccepterConditions_Changed"/>
                        <TextBlock VerticalAlignment="Center" Margin="6,0,0,0">
                            <Run Text="J'accepte les "/>
                            <Hyperlink x:Name="LienConditions" Click="LienConditions_Click">
                                <Run Text="conditions d'utilisation"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <Button x:Name="CreerCompteBTN"
                            Content="Créer un compte"
                            Width="200" Height="40"
                            Background="#FF5070DE" Foreground="White"
                            Click="CreerCompteBTN_Click"
                            Margin="15"
                            IsEnabled="False"/>
                    <TextBlock x:Name="MessageErreurCreationCompte" Foreground="Red" Margin="5" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
