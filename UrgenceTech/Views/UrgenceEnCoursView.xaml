<Window x:Class="UrgenceTech.Views.UrgencesEnCoursView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UrgenceTech.ViewModels"
        xmlns:conv="clr-namespace:UrgenceTech.Converters"
        Title="UrgenceTech - Urgences en cours"
        Height="560" Width="780"
        WindowStartupLocation="CenterScreen">

	

	<Window.DataContext>
		<vm:UrgenceViewModel />
	</Window.DataContext>

	<Grid Background="#F5F5F5">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#D32F2F" Padding="20,14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel>
					<TextBlock Text="Urgences en cours"
                               FontSize="20" FontWeight="Bold" Foreground="White"/>
					<TextBlock Text="{Binding UrgencesEnCours.Count, StringFormat='{}{0} urgence(s) active(s)'}"
                               FontSize="12" Foreground="#FFCDD2"/>
				</StackPanel>

				<Button Grid.Column="1"
                        Content="Actualiser"
                        Command="{Binding ChargerUrgencesEnCoursCommand}"
                        Background="White" Foreground="#D32F2F"
                        FontWeight="SemiBold" Padding="12,6"
                        BorderThickness="0" Cursor="Hand"/>
			</Grid>
		</Border>

		<TextBlock Grid.Row="1"
                   Text="{Binding MessageVue}"
                   FontSize="15" Foreground="#9E9E9E"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding MessageVue, Converter={StaticResource StringToVisibilityConverter}}"/>

		<ListView Grid.Row="1"
                  ItemsSource="{Binding UrgencesEnCours}"
                  SelectedItem="{Binding UrgenceSelectionnee}"
                  Background="Transparent" BorderThickness="0"
                  Margin="10">
			<ListView.View>
				<GridView>
					<GridViewColumn Header="#" Width="45"
                                    DisplayMemberBinding="{Binding ID}"/>
					<GridViewColumn Header="Titre" Width="220"
                                    DisplayMemberBinding="{Binding Titre}"/>
					<GridViewColumn Header="Priorite" Width="90"
                                    DisplayMemberBinding="{Binding Priorite}"/>
					<GridViewColumn Header="Cree par" Width="150"
                                    DisplayMemberBinding="{Binding Utilisateur.NomComplet}"/>
					<GridViewColumn Header="Date creation" Width="150"
                                    DisplayMemberBinding="{Binding DateCreation, StringFormat='dd/MM/yyyy HH:mm'}"/>
				</GridView>
			</ListView.View>
		</ListView>

		<Border Grid.Row="2"
                Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                Padding="16,10"
                Visibility="{Binding UrgenceSelectionnee, Converter={StaticResource NullToVisibilityConverter}}">
			<StackPanel>
				<TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#424242"
                           Text="{Binding UrgenceSelectionnee.Titre}"/>
				<TextBlock FontSize="12" Foreground="#757575" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{Binding UrgenceSelectionnee.Description}"/>
			</StackPanel>
		</Border>

	</Grid>
</Window>
