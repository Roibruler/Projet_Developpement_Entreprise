<UserControl x:Class="UrgenceTech.Views.ProfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F5F5" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Mon profil"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#1976D2"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="30"
                HorizontalAlignment="Left"
                MinWidth="400">
            <StackPanel>

                <TextBlock Text="Informations personnelles"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#333333"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Nom complet" FontWeight="Bold" Foreground="#546E7A" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NomComplet, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Margin="0,0,0,20"/>

                <TextBlock Text="Courriel" FontWeight="Bold" Foreground="#546E7A" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Courriel, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Margin="0,0,0,20"/>

                <TextBlock Text="Rôle" FontWeight="Bold" Foreground="#546E7A" Margin="0,0,0,5"/>
                <Border Background="#E3F2FD" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <TextBlock Text="{Binding Role}" FontSize="13" Foreground="#1976D2" FontWeight="Bold"/>
                </Border>

                <TextBlock Text="Membre depuis" FontWeight="Bold" Foreground="#546E7A" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding DateCreation}" FontSize="15"/>

                <Button Content="Sauvegarder" Width="150" Height="35" Background="#1976d2" Foreground="White" FontWeight="Bold" Command="{Binding SauvegarderCommand}" Margin="0,10,0,0"/>

                <TextBlock Text="{Binding Message}" FontSize="14" Foreground="Green" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>