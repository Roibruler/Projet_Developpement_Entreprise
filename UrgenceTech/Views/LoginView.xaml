<Window x:Class="UrgenceTech.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:UrgenceTech.Converters"
        Title="UrgenceTech - Connexion"
        Height="420" Width="450"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Background="#F5F5F5">

        <Grid Background="#80000000"
              Visibility="{Binding EstEnChargement, Converter={StaticResource BoolToVisibility}}"
              Panel.ZIndex="10">
            <TextBlock Text="Connexion en cours..."
                       Foreground="White"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="350">

            <TextBlock Text="🏥 UrgenceTech"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1976D2"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Connexion"
                       FontSize="16"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBlock Text="Courriel" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Courriel, UpdateSourceTrigger=PropertyChanged}"
                     Height="35" FontSize="14" Padding="8" Margin="0,0,0,15"/>

            <TextBlock Text="Mot de passe" FontWeight="Bold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBoxLogin"
                         Height="35" FontSize="14" Padding="8" Margin="0,0,0,10"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <Border Background="#FFEBEE" BorderBrush="#F44336" BorderThickness="1"
                    CornerRadius="4" Padding="10" Margin="0,0,0,15"
                    Visibility="{Binding MessageErreur, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MessageErreur}" Foreground="#F44336"
                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Button Content="Se connecter"
                    Command="{Binding SeConnecterCommand}"
                    Height="40" FontSize="14" FontWeight="Bold"
                    Background="#1976D2" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>

        </StackPanel>
    </Grid>
</Window>