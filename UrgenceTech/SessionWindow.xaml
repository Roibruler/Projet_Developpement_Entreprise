<Window x:Class="UrgenceTech.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrgenceTech"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Name="txtStatus" FontSize="16" Margin="1,72,0,79" Grid.ColumnSpan="2" Grid.RowSpan="2" Grid.Column="1"/>
        <Button Content="Déconnexion" HorizontalAlignment="Center"
            VerticalAlignment="Top" Margin="0,114,0,0"
            Click="Logout_Click" RenderTransformOrigin="3.899,10.864" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
            />
    </Grid>
</Window>
